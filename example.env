# ─────────────────────────────────────────────────────────────────────────
# LFG — example environment
# Copy to .env and fill in. `.env` is gitignored; never commit real secrets.
#   cp example.env .env
#
# The bare minimum to boot locally is the two BETTER_AUTH_* values plus one AI
# provider key (ANTHROPIC_API_KEY). Everything else is optional / feature-gated.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL of THIS app. Used in emails and OAuth callbacks.
APP_URL=http://localhost:3000

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# better-auth (https://www.better-auth.com). Generate a secret:  openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers (optional — leave blank to disable that button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=https://gitlab.com

# ── Database ─────────────────────────────────────────────────────────────
# "sqlite" (default, zero-setup local dev) or "postgresql" (production).
DATABASE_DRIVER=sqlite
# sqlite: path to the db file. postgresql: a postgres:// URL (overrides the parts below).
DATABASE_URL=./data/lfg.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lfg_node
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── AI providers ─────────────────────────────────────────────────────────
# At least one is needed for the product to do anything useful.
#   Anthropic:  https://console.anthropic.com/settings/keys
#   OpenAI:     https://platform.openai.com/api-keys
#   Google AI:  https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
# Exa web-search (optional): https://dashboard.exa.ai/
EXA_API_KEY=

# ── At-rest secret encryption ────────────────────────────────────────────
# Encrypts stored per-user secrets (AES-256-GCM). REQUIRED in production
# (the app refuses to store secrets unencrypted when NODE_ENV=production).
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ── Sandbox / code-execution backend ─────────────────────────────────────
# Where Instant builds + ticket execution run coding agents.
#   mags   → Magpie Cloud Firecracker micro-VMs (hosted; needs MAGS_API_TOKEN)
#   docker → local Docker containers (self-hosted; needs Docker installed)
SANDBOX_BACKEND=mags

# --- docker backend ---
# Prebuilt image with node + python + claude-code + pi. Build it once:
#   ./scripts/build-sandbox-image.sh youruser/lfg-sandbox:latest --push
SANDBOX_IMAGE=lfg-sandbox:latest
# Network mode: "bridge" (default) isolates each container and publishes its app
# port to a unique host port (no collisions; works on macOS + Linux). "host" binds
# the port directly on the host (Linux only; apps must use distinct ports).
SANDBOX_DOCKER_NETWORK=bridge
# Port an app listens on INSIDE its container (the Instant scaffold uses 8080).
SANDBOX_APP_PORT=8080
SANDBOX_PREVIEW_HOST=http://localhost
SANDBOX_BROWSER_IMAGE=zenika/alpine-chrome:latest

# --- mags backend ---
# Get a token at https://mags.run (see @magpiecloud/mags).
MAGS_API_TOKEN=
MAGS_API_URL=https://api.magpiecloud.com
MAGS_APP_DOMAIN=app.lfg.run
MAGPIE_API_KEY=

# ── File storage ─────────────────────────────────────────────────────────
# "local" → binaries written to LOCAL_STORAGE_DIR (must be writable), served at
#           /storage/<key>. Text content lives in the DB.
# "s3"    → uploads go to AWS S3 (needs the AWS_* values below).
FILE_STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/uploads
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1

# ── Email (SendGrid) ─────────────────────────────────────────────────────
# Transactional email (verification, invitations). Without a key, emails are
# logged to the console in dev instead of sent.
# Sign up: https://signup.sendgrid.com → Settings → API Keys → "Create API Key"
# (Mail Send permission). Verify a sender/domain under Settings → Sender Authentication.
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Composio (optional integrations) ─────────────────────────────────────
# Lets agents call third-party tools (Gmail, Slack, …). Free tier available.
# Sign up + key: https://app.composio.dev  (Settings → API Keys)
COMPOSIO_API_KEY=

# ── Cloudflare Turnstile (optional bot protection on sign-in) ────────────
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Public Telegram bot (optional) ───────────────────────────────────────
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_BOT_OWNER_ID=

# ── Per-user Postgres provisioning (optional, advanced) ──────────────────
# Leave HOST blank to disable. Spins up isolated Postgres DBs for generated apps.
POSTGRES_PROVISIONING_HOST=
POSTGRES_PROVISIONING_PORT=5432
POSTGRES_PROVISIONING_USER=postgres
POSTGRES_PROVISIONING_PASSWORD=

# ── Ticket auto-demo (records a demo of each completed ticket) ────────────
# When a ticket build succeeds, an automated Mags browser records a walkthrough
# (frontend) or an API terminal transcript (backend), shown in the ticket Preview
# tab. Set to "off" to disable.
TICKET_DEMO=on
# Preview-mode auth bypass for the recorder (sandbox-only, inert in real prod unless
# the app honors it). Generated apps treat a cookie named LFG_PREVIEW_COOKIE_NAME
# whose value equals LFG_PREVIEW_SECRET as a logged-in "Preview User", so protected
# pages can be demoed without a real Google OAuth flow. Use a strong random secret.
LFG_PREVIEW_COOKIE_NAME=lfg_preview_session
LFG_PREVIEW_SECRET=change-me-to-a-random-secret
