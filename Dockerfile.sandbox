# LFG sandbox image — the environment where AI-generated code is built & run
# when SANDBOX_BACKEND=docker.
#
# Ships Node 22 + Python 3 + git + the two coding agents (claude-code and pi)
# preinstalled, so container starts are fast (no per-run tool install).
#
# Build & push once, then point the app at it via SANDBOX_IMAGE:
#   ./scripts/build-sandbox-image.sh youruser/lfg-sandbox:latest --push
#   # .env:  SANDBOX_IMAGE=youruser/lfg-sandbox:latest
FROM node:22-bookworm

# System toolchain: python (many generated apps are Python), git, build tools,
# and curl. Kept lean; add language runtimes here as your stacks require.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv \
      git curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

# Coding agents used by ticket execution + Instant builds.
#   @anthropic-ai/claude-code → provides the `claude` binary (Anthropic models)
#   @mariozechner/pi-coding-agent → provides the `pi` binary (OpenAI/Gemini/DeepSeek/Kimi/GLM…)
RUN npm install -g \
      @anthropic-ai/claude-code \
      @mariozechner/pi-coding-agent \
    && npm cache clean --force

# Workspace the app clones projects into (matches WORKING_DIR conventions).
WORKDIR /workspace
ENV HOME=/root
ENV PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"

# Sanity: fail the build if either agent didn't land on PATH.
# (@anthropic-ai/claude-code installs the `claude` command, not `claude-code`.)
RUN command -v claude >/dev/null && command -v pi >/dev/null \
    && node -v && python3 --version

# Kept alive by the app via `docker run ... sleep infinity`; this is just a default.
CMD ["sleep", "infinity"]
