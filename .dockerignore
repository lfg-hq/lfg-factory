# Dependencies (reinstalled inside the image)
node_modules

# Secrets — never bake env files into an image layer
.env
.env.*
!example.env
.kamal/secrets
config/deploy.yml

# Local data / user uploads (mounted as volumes at runtime)
data
uploads
*.db
*.sqlite
*.sqlite3

# Build output & caches
out
dist
coverage
*.tsbuildinfo
.cache
.eslintcache

# VCS & editor
.git
.gitignore
.idea
.vscode
.DS_Store

# Agent / local tooling
.claude
CLAUDE.md
claude.status
screenshots
*.log

backups/
# Local checkouts, scratch output and the desktop app never belong in the server image.
# Git worktrees and test environments carry their own copies of .env.
.worktrees
.desktop-test
desktop
output
.deck-build
Untitled
**/node_modules

# Env files at ANY depth (the rules above only cover the top level)
**/.env
**/.env.*
**/credentials.json
!example.env
