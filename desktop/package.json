{
  "name": "lfg-desktop",
  "productName": "LFG",
  "version": "0.1.0",
  "description": "LFG Desktop: your company's LFG, with coding jobs run on this computer by Claude Code.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "lfg-runner": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p . && cp src/preload.cjs src/setup.html dist/",
    "start": "npm run build && electron .",
    "runner": "npm run build && node dist/cli.js",
    "typecheck": "tsc -p . --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "playwright-core": "^1.61.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "ai.lfg.desktop",
    "productName": "LFG",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LFG uses the microphone when you dictate a message or talk to the agent."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icon.png"
    },
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ]
  }
}
